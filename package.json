{
  "name": "java-architecture-learning-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Java architecture learning notes powered by VuePress.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "docs:dev": "vuepress dev . --clean-cache --clean-temp",
    "docs:build": "vuepress build . --clean-cache --clean-temp",
    "docs:check-public": "node scripts/check-public-content.mjs",
    "docs:check-artifact": "node scripts/check-public-content.mjs --artifact .vuepress/dist",
    "docs:verify": "npm run docs:check-public && npm run docs:build && npm run docs:check-artifact"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.130",
    "sass": "1.99.0",
    "sass-embedded": "1.99.0",
    "sass-loader": "16.0.8",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  }
}
